# Base mainnet
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# Web application
# Public origin the app is served from; drives OG tags, the manifest and the SIWE domain check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser sends its Base reads. Unset, they go through this app's own /api/rpc, which
# forwards a fixed list of read methods to BASE_RPC_URL and keeps any key out of the client bundle.
NEXT_PUBLIC_BASE_RPC_URL=
# ERC-8021 Builder Code issued by base.dev. Unset, transactions go out unattributed.
NEXT_PUBLIC_BUILDER_CODE=
# Signs the session cookie. Unset, a random secret is minted per process.
SESSION_SECRET=
