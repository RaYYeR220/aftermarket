# Base mainnet
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
BASESCAN_API_KEY=

# Web application
# Public origin the app is served from; drives OG tags, the manifest and the SIWE domain check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the browser sends its Base reads. Unset, they go through this app's own /api/rpc, which
# forwards a fixed list of read methods to BASE_RPC_URL and keeps any key out of the client bundle.
NEXT_PUBLIC_BASE_RPC_URL=
# ERC-8021 Builder Code, claimed at https://base.dev under Settings -> Builder Code.
# A plain lowercase ASCII string, 1-32 chars of a-z, 0-9 and _ (e.g. bc_b7k3p9da). NOT hex: a
# 0x... value is encoded literally and resolves to nobody. Codes live in Base's own registry and
# cannot be derived or self-minted, so leave this empty rather than invent one -- unset, the
# encoder emits no suffix and transactions go out unattributed, which is correct for a fork.
NEXT_PUBLIC_BUILDER_CODE=
# Signs the session cookie. Unset, a random secret is minted per process.
SESSION_SECRET=
