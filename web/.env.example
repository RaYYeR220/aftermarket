# Base mainnet JSON-RPC endpoint used for every server-side read.
# Falls back to https://mainnet.base.org when unset.
BASE_RPC_URL=https://mainnet.base.org

# Canonical origin. Drives OG tags, the SIWE domain check and the manifest URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Builder Code (ERC-8021), attached as a calldata suffix to every transaction
# this app sends. Claim one at https://base.dev under Settings -> Builder Code;
# it is free but it needs an account there, and a code cannot be derived or
# self-minted -- Base's registry gates minting behind REGISTER_ROLE.
#
# Format: plain lowercase ASCII, 1-32 characters of a-z, 0-9 and _, e.g.
# bc_b7k3p9da. NOT hex. A 0x... value is encoded literally rather than
# rejected, producing a well-formed suffix that resolves to nobody, so an
# invented code is worse than none. Leave blank to send unattributed.
#
# bc_ftoaimc9 was issued to the project deployer by Base's own agent
# endpoint (POST /v1/agents/builder-codes) but, as of this writing, is not
# yet minted in the on-chain registry -- see README -> Attribution for the
# `cast` check and what it means for transactions already sent.
NEXT_PUBLIC_BUILDER_CODE=bc_ftoaimc9

# Signs the Sign in with Base session cookie. Any long random string; generate
# one with `openssl rand -hex 32`. Without it the process mints a secret at
# boot, so sessions end when the process does and do not survive a restart or
# travel between instances.
SESSION_SECRET=
