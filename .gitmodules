[submodule "contracts/lib/openzeppelin-contracts"]
	path = contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "contracts/lib/morpho-blue"]
	path = contracts/lib/morpho-blue
	url = https://github.com/morpho-org/morpho-blue
[submodule "contracts/lib/verifications"]
	path = contracts/lib/verifications
	url = https://github.com/coinbase/verifications
[submodule "contracts/lib/base-std"]
	path = contracts/lib/base-std
	url = https://github.com/base/base-std
[submodule "contracts/lib/spend-permissions"]
	path = contracts/lib/spend-permissions
	url = https://github.com/coinbase/spend-permissions
