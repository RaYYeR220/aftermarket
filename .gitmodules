[submodule "contracts/lib/openzeppelin-contracts"]
	path = contracts/lib/openzeppelin-contracts
	url = https://github.com/OpenZeppelin/openzeppelin-contracts
[submodule "contracts/lib/morpho-blue"]
	path = contracts/lib/morpho-blue
	url = https://github.com/morpho-org/morpho-blue
[submodule "contracts/lib/verifications"]
	path = contracts/lib/verifications
	url = https://github.com/coinbase/verifications
[submodule "contracts/lib/base-std"]
	path = contracts/lib/base-std
	url = https://github.com/base/base-std
[submodule "contracts/lib/spend-permissions"]
	path = contracts/lib/spend-permissions
	url = https://github.com/coinbase/spend-permissions
	# Provenance only. Nothing here is compiled or remapped: it is the upstream source the
	# SpendPermission struct in src/interfaces/ISpendPermissionManager.sol was retyped from, kept
	# so the two can be diffed. Its own test dependencies nest deep enough to blow past the
	# Windows 260-character path limit, which used to abort the whole recursive init before it
	# reached lib/verifications, so it is skipped by default. Fetch it with
	# `git submodule update --init --checkout contracts/lib/spend-permissions`.
	update = none
	# Those same paths also defeat the checkout itself: on Windows the nested Hardhat fixtures
	# under lib/smart-wallet cannot be written at all, so a tree that has fetched this submodule
	# reports working-tree dirt that no commit can ever clear. Ignore that dirt, not the pointer -
	# a real change to the pinned commit still shows up in `git status`.
	ignore = dirty
