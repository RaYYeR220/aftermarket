# Base mainnet RPC endpoint the keeper reads from, and the evaluation forks.
BASE_RPC_URL=https://mainnet.base.org

# The keeper's signing key. This is the ONLY way to give the service a signer: there is no flag,
# file path or keystore option that will do it, so a key can never be committed by accident.
# Leave it unset to run in dry-run mode, which is the default in any case.
KEEPER_PRIVATE_KEY=

# Extra addresses to watch, on top of the accounts discovered from AutoRepayer's enrolment events.
# Comma-separated. Useful for a demo account that has not enrolled yet.
KEEPER_ACCOUNTS=

# Where the JSONL decision trail is written. Relative to the working directory.
KEEPER_AUDIT_PATH=audit/decisions.jsonl

# Override the base-anvil binary the evaluation launches. Only needed when it is not installed at
# ~/.foundry/bin/base-anvil.
ANVIL_BIN=
